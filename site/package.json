    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.0",
        "@sveltejs/kit": "^2.70.4",
        "@sveltejs/vite-plugin-svelte": "^5.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "mdsvex": "^0.12.3",
        "shiki": "^1.0.0",
        "vite": "^6.4.6",
        "svelte-check": "^4.1.0",
        "typescript": "^5.7.0"
